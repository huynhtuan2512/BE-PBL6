# ==== Database ====
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/robot_restaurant_db

# ==== JWT ====
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==== Device Static API Key (ESP32 / Raspberry Pi) ====
DEVICE_API_KEY=esp32-rpi-static-secret-key

# ==== ThingsBoard MQTT / REST ====
THINGSBOARD_HOST=localhost
THINGSBOARD_MQTT_PORT=1883
THINGSBOARD_REST_URL=http://localhost:8080
THINGSBOARD_USERNAME=tenant@thingsboard.org
THINGSBOARD_PASSWORD=tenant

# ==== App ====
PROJECT_NAME=Robot Phuc Vu Nha Hang API
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
